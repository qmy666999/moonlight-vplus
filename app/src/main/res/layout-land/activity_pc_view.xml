<!-- Material 3 landscape shell: navigation rail + host grid + scene rail. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcViewRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:clipChildren="false"
    tools:context=".PcView">

    <ImageView
        android:id="@+id/pcBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/pcBackgroundScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/m3_surface_scrim"
        android:importantForAccessibility="no" />

    <Space
        android:id="@+id/topSafeArea"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_alignParentTop="true" />

    <LinearLayout
        android:id="@+id/pcSideRail"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topSafeArea"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/m3_top_bar_bg"
        android:elevation="2dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/settingsButton"
            style="@style/Widget.Moonlight.M3.IconButton.Tonal"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_cd_settings"
            android:cropToPadding="false"
            android:nextFocusForward="@id/aboutButton"
            android:scaleType="fitCenter" />

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/aboutButton"
            style="@style/Widget.Moonlight.M3.IconButton"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_cd_about"
            android:cropToPadding="false"
            android:nextFocusForward="@id/easyTierControlButton"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info" />

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/easyTierControlButton"
            style="@style/Widget.Moonlight.M3.IconButton"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_cd_easytier"
            android:cropToPadding="false"
            android:nextFocusForward="@id/pcToolbarMenuButton"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_network_control" />

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/pcToolbarMenuButton"
            style="@style/Widget.Moonlight.M3.IconButton"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_toolbar_menu"
            android:cropToPadding="false"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topSafeArea"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:layout_toEndOf="@id/pcSideRail"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:gravity="center">

        <include layout="@layout/view_host_search_state" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/scenePresetContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/m3_page_margin"
        android:layout_marginBottom="@dimen/m3_page_margin"
        android:background="@drawable/m3_scene_panel_bg"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/scene1Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_1daed"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene2Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_f2a94"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene3Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_0a468"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene4Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_94f3b"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene5Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_4b18b"
            android:src="@drawable/ic_triangle_left" />
    </LinearLayout>

</RelativeLayout>
