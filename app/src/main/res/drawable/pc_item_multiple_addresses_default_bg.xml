<?xml version="1.0" encoding="utf-8"?>
<!-- M3 stacked surface for hosts reachable on multiple addresses. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorSurfaceContainerHigh" />
            <corners android:radius="@dimen/m3_shape_extra_large" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorSurfaceContainerLow" />
            <corners android:radius="@dimen/m3_shape_extra_large" />
            <stroke
                android:width="1dp"
                android:color="?attr/m3ColorOutlineVariant" />
        </shape>
    </item>
</layer-list>
