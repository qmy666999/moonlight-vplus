<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="80"
    android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorSurfaceContainerHigh" />
            <corners android:radius="@dimen/m3_shape_extra_large" />
            <stroke
                android:width="2dp"
                android:color="?attr/m3ColorPrimary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorSurfaceContainer" />
            <corners android:radius="@dimen/m3_shape_extra_large" />
            <stroke
                android:width="2dp"
                android:color="?attr/m3ColorPrimary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorSurfaceContainer" />
            <corners android:radius="@dimen/m3_shape_extra_large" />
            <stroke
                android:width="2dp"
                android:color="?attr/m3ColorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorSurfaceContainerLow" />
            <corners android:radius="@dimen/m3_shape_extra_large" />
            <stroke
                android:width="1dp"
                android:color="?attr/m3ColorOutlineVariant" />
        </shape>
    </item>
</selector>
