<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/appAccentSoft">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/m3_surface_container_high" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/appAccent" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="oval">
                    <solid android:color="@color/m3_surface_container" />
                    <stroke
                        android:width="2dp"
                        android:color="?attr/appAccent" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/m3_surface_container" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/m3_outline_variant" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
