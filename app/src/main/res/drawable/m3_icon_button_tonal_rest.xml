<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_primary_container" />
            <corners android:radius="@dimen/m3_shape_large" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container_high" />
            <corners android:radius="@dimen/m3_shape_large" />
            <stroke
                android:width="2dp"
                android:color="?attr/appAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container" />
            <corners android:radius="@dimen/m3_shape_large" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_outline_variant" />
        </shape>
    </item>
</selector>
