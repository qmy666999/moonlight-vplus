<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="NumberSeekbar">
        <attr name="max" format="integer" />
        <attr name="min" format="integer" />
        <attr name="text" format="string" />
        <attr name="progress" format="integer" />
    </declare-styleable>
    <!-- 自定义IconListPreference属性 -->
    <declare-styleable name="IconListPreference">
        <attr name="entryIcons" format="reference" />
    </declare-styleable>

    <!--
        首页背景强调色槽位。默认值指向品牌粉（ui_shell_accent 系）；
        选择“跟随壁纸”后，由 YouAccentOverlayBg0..11 切换到背景对应的色相桶。
    -->
    <attr name="appAccent" format="color" />
    <attr name="appAccentSoft" format="color" />
    <attr name="appAccentFocus" format="color" />

    <!--
        Material 3 semantic roles for the View system. Compose consumes the same
        values through MoonlightTheme.kt. Primary roles stay tied to appAccent
        so the wallpaper-derived palette remains fully dynamic.
    -->
    <attr name="m3ColorPrimary" format="color" />
    <attr name="m3ColorOnPrimary" format="color" />
    <attr name="m3ColorPrimaryContainer" format="color" />
    <attr name="m3ColorOnPrimaryContainer" format="color" />
    <attr name="m3ColorSecondary" format="color" />
    <attr name="m3ColorSecondaryContainer" format="color" />
    <attr name="m3ColorSurface" format="color" />
    <attr name="m3ColorOnSurface" format="color" />
    <attr name="m3ColorOnSurfaceVariant" format="color" />
    <attr name="m3ColorOutline" format="color" />
    <attr name="m3ColorOutlineVariant" format="color" />
    <attr name="m3ColorSurfaceContainerLow" format="color" />
    <attr name="m3ColorSurfaceContainer" format="color" />
    <attr name="m3ColorSurfaceContainerHigh" format="color" />
</resources>