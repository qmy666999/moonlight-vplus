<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 type scale for Moonlight V+.

    The scale is intentionally identical to the M3 baseline. Use a semantic
    style (TitleMedium, BodySmall, LabelLarge, ...) rather than a raw sp value
    so density, accessibility font scaling, and future type updates remain
    consistent across the View and Compose layers.
-->
<resources>
    <style name="TextAppearance.Moonlight.M3.DisplayLarge" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">57sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.DisplayMedium" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">45sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.DisplaySmall" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Moonlight.M3.HeadlineLarge" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.HeadlineMedium" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.HeadlineSmall" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Moonlight.M3.TitleLarge" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.TitleMedium" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.009</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.TitleSmall" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Moonlight.M3.BodyLarge" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.031</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.BodyMedium" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.018</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.BodySmall" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.033</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Moonlight.M3.LabelLarge" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.LabelMedium" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.042</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Moonlight.M3.LabelSmall" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.045</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Product wordmark, not part of the M3 baseline scale. -->
    <style name="TextAppearance.Moonlight.M3.Brand" parent="TextAppearance.Moonlight.M3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
</resources>
