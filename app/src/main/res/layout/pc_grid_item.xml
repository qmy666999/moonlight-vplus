<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 host card: tonal surface, leading 64 dp artwork, two-line title,
     inline network quality, and a compact status badge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/m3_host_card_height"
    android:background="@drawable/pc_item_selector"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:stateListAnimator="@animator/expressive_item_state">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pc_grid_item_clip_bg"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:clipToPadding="true"
        android:outlineProvider="background">

        <FrameLayout
            android:id="@+id/grid_icon_container"
            android:layout_width="@dimen/m3_host_icon_size"
            android:layout_height="@dimen/m3_host_icon_size"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp">

            <View
                android:id="@+id/pcIconGlow"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/pcIconBg"
                android:layout_width="@dimen/m3_host_icon_size"
                android:layout_height="@dimen/m3_host_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="@dimen/m3_host_icon_inner_size"
                android:layout_height="@dimen/m3_host_icon_inner_size"
                android:layout_gravity="center"
                android:background="@drawable/m3_icon_image_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/pc_icon_description"
                android:elevation="1dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="@dimen/m3_state_badge_size"
                android:layout_height="@dimen/m3_state_badge_size"
                android:layout_gravity="bottom|end"
                android:background="@drawable/m3_badge_bg"
                android:contentDescription="@string/pc_status_description"
                android:elevation="2dp"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/grid_spinner"
                android:layout_width="40dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@string/loading_description"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/white_dots_animation" />
        </FrameLayout>

        <TextView
            android:id="@+id/grid_text"
            style="@style/PcHostNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="14dp"
            android:layout_toEndOf="@id/grid_icon_container"
            android:ellipsize="end"
            android:maxLines="2"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="none"
            android:textColor="@color/m3_on_surface"
            tools:ignore="RtlHardcoded"
            tools:text="Living room PC" />

        <LinearLayout
            android:id="@+id/grid_network_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:layout_toEndOf="@id/grid_icon_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/grid_network_quality_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/phc_perf_wifi"
                app:tint="?attr/appAccent" />

            <TextView
                android:id="@+id/grid_network_quality_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Moonlight.M3.LabelMedium"
                android:textColor="@color/m3_on_surface_variant"
                tools:text="9 ms · 62 Mbps" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
