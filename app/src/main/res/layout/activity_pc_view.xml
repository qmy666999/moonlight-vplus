<!-- Material 3 host shell: tonal app bar, scrolling host grid, scene rail. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcViewRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:clipChildren="false"
    tools:context=".PcView">

    <ImageView
        android:id="@+id/pcBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/pcBackgroundScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/m3_surface_scrim"
        android:importantForAccessibility="no" />

    <Space
        android:id="@+id/topSafeArea"
        android:layout_width="match_parent"
        android:layout_height="@dimen/activity_safearea_top"
        android:layout_alignParentTop="true" />

    <!-- M3 top app bar: leading settings, product identity, then actions. -->
    <LinearLayout
        android:id="@+id/pcTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topSafeArea"
        android:layout_marginStart="@dimen/m3_page_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/m3_page_margin"
        android:background="@drawable/m3_top_bar_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/m3_top_bar_height"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/settingsButton"
            style="@style/Widget.Moonlight.M3.IconButton.Tonal"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_cd_settings"
            android:cropToPadding="false"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pcTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pcview_m3_title"
                android:textAppearance="@style/TextAppearance.Moonlight.M3.Brand"
                android:textColor="@color/m3_on_surface" />

            <TextView
                android:id="@+id/pcSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pcview_m3_subtitle"
                android:textAppearance="@style/TextAppearance.Moonlight.M3.BodySmall"
                android:textColor="@color/m3_on_surface_variant" />
        </LinearLayout>

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/aboutButton"
            style="@style/Widget.Moonlight.M3.IconButton"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_cd_about"
            android:cropToPadding="false"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info" />

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/easyTierControlButton"
            style="@style/Widget.Moonlight.M3.IconButton"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_cd_easytier"
            android:cropToPadding="false"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_network_control" />

        <com.limelight.ui.ExpressiveToolbarButton
            android:id="@+id/pcToolbarMenuButton"
            style="@style/Widget.Moonlight.M3.IconButton"
            android:layout_width="@dimen/m3_icon_button_size"
            android:layout_height="@dimen/m3_icon_button_size"
            android:contentDescription="@string/pcview_toolbar_menu"
            android:cropToPadding="false"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/pcTopBar"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:gravity="center">

        <include layout="@layout/view_host_search_state" />

    </RelativeLayout>

    <!-- Scene presets are secondary actions, grouped in one tonal surface. -->
    <LinearLayout
        android:id="@+id/scenePresetContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/m3_page_margin"
        android:layout_marginBottom="@dimen/m3_page_margin"
        android:background="@drawable/m3_scene_panel_bg"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/scene1Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_1daed"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene2Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_f2a94"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene3Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_0a468"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene4Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_94f3b"
            android:src="@drawable/ic_triangle_left" />

        <ImageButton
            android:id="@+id/scene5Btn"
            style="@style/Widget.Moonlight.M3.SceneButton"
            android:contentDescription="@string/layout_pc_view_cd_4b18b"
            android:src="@drawable/ic_triangle_left" />
    </LinearLayout>

</RelativeLayout>
